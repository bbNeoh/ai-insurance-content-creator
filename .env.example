# ─────────────────────────────────────────────────────────────────
# AI Insurance Content Creator — Environment Variables
# ─────────────────────────────────────────────────────────────────
# Add the API key for the provider you want to use.
# The app auto-detects which one to use based on which key is set.
# If you have multiple keys, set AI_PROVIDER to choose one.
# ─────────────────────────────────────────────────────────────────

# ── Option 1: Anthropic Claude (Haiku) ───────────────────────────
# Get key at: https://console.anthropic.com/
# Cost: ~$0.005 per full workflow run
# ANTHROPIC_API_KEY=sk-ant-PASTE_YOUR_KEY_HERE

# ── Option 2: OpenAI (GPT-4o-mini) ───────────────────────────────
# Get key at: https://platform.openai.com/api-keys
# Cost: ~$0.001 per full workflow run
# OPENAI_API_KEY=sk-PASTE_YOUR_KEY_HERE

# ── Option 3: DeepSeek (deepseek-chat) — Cheapest ────────────────
# Get key at: https://platform.deepseek.com/
# Cost: ~$0.001 per full workflow run
# DEEPSEEK_API_KEY=sk-PASTE_YOUR_KEY_HERE

# ── Optional: Force a specific provider ──────────────────────────
# Uncomment and set to: anthropic / openai / deepseek
# AI_PROVIDER=deepseek

# ── Optional: Change the port (default: 3000) ────────────────────
# PORT=3000

# ─────────────────────────────────────────────────────────────────
# Image Generation — Choose one or more (UI lets user pick)
# ─────────────────────────────────────────────────────────────────

# ── DALL·E 3 (OpenAI) ────────────────────────────────────────────
# Uses the same OPENAI_API_KEY above — no extra key needed.
# Cost: ~$0.04 per image (1024x1024)

# ── SeedDream / Dreamina ──────────────────────────────────────────
# Supports image-to-image via reference photo upload.
# Get an API key from one of these providers (all support SeedDream):
#   • https://www.laozhang.ai          (default, OpenAI-compatible)
#   • https://openrouter.ai            (model: bytedance-seed/seedream-4.5)
#   • https://fal.ai                   (fal-ai/bytedance/seedream/v4)
# SEEDREAM_API_KEY=sk-PASTE_YOUR_KEY_HERE
#
# Optional: change provider base URL (default: laozhang.ai)
# SEEDREAM_BASE_URL=https://api.laozhang.ai
#
# Optional: override the model name
# SEEDREAM_MODEL=seedream-4-0-250828

# ── Google Gemini ─────────────────────────────────────────────────
# Get key at: https://aistudio.google.com/app/apikey
# Note: image generation requires billing to be enabled on your account.
# GEMINI_API_KEY=AIzaSy-PASTE_YOUR_KEY_HERE
#
# Optional: override the model (default: gemini-2.0-flash-exp)
# GEMINI_IMAGE_MODEL=gemini-2.0-flash-exp

# ── HeyGen — AI Avatar Video Generation (Step 3, Reel posts) ─────
# Get key at: https://app.heygen.com/settings?tab=api
# Requires a paid HeyGen plan (Creator $29/mo or above)
# HEYGEN_API_KEY=PASTE_YOUR_KEY_HERE

# ─────────────────────────────────────────────────────────────────
# Social Media Auto-Posting (Step 4) — All Optional
# ─────────────────────────────────────────────────────────────────

# ── Facebook ─────────────────────────────────────────────────────
# 1. Create a Facebook App at https://developers.facebook.com/
# 2. Add "Facebook Login" + "Pages API" products
# 3. Generate a Page Access Token via Graph API Explorer
#    (needs pages_manage_posts + pages_read_engagement permissions)
# FACEBOOK_PAGE_ID=123456789
# FACEBOOK_PAGE_ACCESS_TOKEN=EAAxxxxxxxxxxxxx

# ── Instagram ────────────────────────────────────────────────────
# Requires an Instagram Business/Creator account linked to a Facebook Page
# 1. Use the same Facebook App above
# 2. Get your Instagram User ID from Graph API Explorer:
#    GET /me?fields=id,name with instagram_basic permission
# 3. Requires an AI image generated in Step 3 to post
# 4. For local servers: set SITE_URL to a public tunnel (e.g. ngrok)
#    without it, Instagram cannot fetch the image from localhost
# INSTAGRAM_USER_ID=123456789
# INSTAGRAM_ACCESS_TOKEN=EAAxxxxxxxxxxxxx
# SITE_URL=https://your-ngrok-or-domain.com

# ── LinkedIn ─────────────────────────────────────────────────────
# 1. Create a LinkedIn App at https://www.linkedin.com/developers/
# 2. Add "Share on LinkedIn" + "Sign In with LinkedIn" products
# 3. Generate an access token with w_member_social scope
# 4. Get your Person URN: GET https://api.linkedin.com/v2/me
#    (use urn:li:person:XXXX for personal, urn:li:organization:XXXX for company page)
# LINKEDIN_ACCESS_TOKEN=AQxxxxxxxxxxxxx
# LINKEDIN_AUTHOR=urn:li:person:XXXXXXXXXXXX

# ─── ONLINE (Netlify) ────────────────────────────────────────────
# Team password that locks the app when it's online. Leave empty on your own PC.
# APP_PASSWORD=choose-a-strong-team-password
# Long random text used to sign the unlock cookie. Set a unique value online.
# JWT_SECRET=paste-a-long-random-string
